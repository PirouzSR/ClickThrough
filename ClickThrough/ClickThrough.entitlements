<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A global event tap and the Accessibility API are incompatible with the
	     App Sandbox, so this utility is deliberately not sandboxed. It requests
	     no other entitlement and no other privacy permission. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
